.DS_Store

# Editor / agent tooling that is per-machine. A contributor's global git config may or may
# not ignore these, so the repo does not depend on it: `.claude/settings.local.json` here
# held 28 KB of this machine's command history, including absolute paths.
.claude/settings.local.json
.claude/
.vscode/
.idea/

# Dependencies — never tracked; restored by `pnpm install`
node_modules/

# Build output — regenerated by `pnpm build`
lib/
*.tsbuildinfo
# Packed tarballs are release artifacts, not sources
*.tgz
_native-reference/
