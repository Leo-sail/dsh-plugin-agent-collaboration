{
  "name": "dsh-plugin-agent-collaboration",
  "description": "Bot Community plugin for DSH — persistent bots, rooms, and runs",
  "version": "0.3.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-plugin-agent-community/agent-community": "file:../../core/agent-community",
    "@dsh-plugin-agent-community/tool-agent-community": "file:../../tools/tool-agent-community",
    "@dsh-plugin-agent-community/ui-agent-community": "file:../../ui/ui-agent-community"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "bundle": "tsdown",
    "pack:release": "bash ../../../scripts/pack-release.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "leochang <leochang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo-sail/dsh-plugin-agent-collaboration.git"
  },
  "homepage": "https://github.com/Leo-sail/dsh-plugin-agent-collaboration#readme",
  "bugs": {
    "url": "https://github.com/Leo-sail/dsh-plugin-agent-collaboration/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bot",
    "agent"
  ]
}
