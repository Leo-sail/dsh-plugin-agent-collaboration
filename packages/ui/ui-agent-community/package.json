{
  "name": "@dsh-plugin-agent-community/ui-agent-community",
  "description": "Agent Community UI — Bot list, room list, chat panel, run status",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "bundle": "tsdown && node ../../../scripts/wrap-client.mjs lib/client.js @dsh-plugin-agent-community/ui-agent-community"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@dsh-plugin-agent-community/agent-community"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0",
    "@dsh-plugin-agent-community/agent-community": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "leochang <leochang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo-sail/dsh-plugin-agent-collaboration.git",
    "directory": "packages/ui/ui-agent-community"
  },
  "homepage": "https://github.com/Leo-sail/dsh-plugin-agent-collaboration/tree/main/packages/ui/ui-agent-community#readme",
  "bugs": {
    "url": "https://github.com/Leo-sail/dsh-plugin-agent-collaboration/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bot",
    "agent"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
