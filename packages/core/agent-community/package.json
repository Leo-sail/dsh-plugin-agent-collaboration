  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
